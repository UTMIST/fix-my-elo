
ENGINE_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:3000

# Move-request defaults, used when the frontend omits them.
AGENT_MOVE_DEFAULT_NUM_SIM=120
AGENT_MOVE_DEFAULT_TEMP=0.0
# Upstream engine timeout, in milliseconds. MIN is the floor applied to an override.
AGENT_MOVE_TIMEOUT_MS=150000
AGENT_MOVE_MIN_TIMEOUT_MS=100000

MODEL_PATH=services/engine_service/model_weights/SL_trained_stockfish_trained.pth
C_PUCT=1.0
DIRICHLET_ALPHA=0.3
DIRICHLET_EPSILON=0.0
MCTS_BATCH_SIZE=8
NUM_SIM_DEFAULT=120
TEMP_DEFAULT=0.0

BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ENGINE_REQUEST_TIMEOUT_MS=170000
NEXT_PUBLIC_DEFAULT_NUM_SIMULATIONS=120
