# Python interpreter used by Next.js API route for Team2 agent calls
TEAM2_PYTHON=/opt/homebrew/Caskroom/miniconda/base/bin/python

# Local path where the model should live on disk
TEAM2_MODEL_PATH=/Users/khushi.malik/GitProjects/fix-my-elo/Team2/model_files/model.pth

# Public download URL for the .pth file (used in Docker deployment)
# Example: https://drive.google.com/uc?id=FILE_ID&export=download
# To get the direct URL from a Google Drive share link:
# 1. Extract the FILE_ID from: https://drive.google.com/file/d/FILE_ID/view?...
# 2. Use: https://drive.google.com/uc?id=FILE_ID&export=download
TEAM2_MODEL_URL=https://drive.google.com/file/d/1bsHqErkp6HMh1PGGKo5y9Mi72lA4MWmI/view?usp=drive_link
