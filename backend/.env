# Local dev config for the api service (loaded by api/main.py via python-dotenv).
# These values work as-is when the engine runs locally on port 8001.

# Base URL of the engine service. "/move" is appended by the api.
ENGINE_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:3000

# Move-request defaults (used when the frontend omits them).
AGENT_MOVE_DEFAULT_NUM_SIM=120
AGENT_MOVE_DEFAULT_TEMP=0.0

# Upstream engine timeout, in milliseconds.
AGENT_MOVE_TIMEOUT_MS=150000
AGENT_MOVE_MIN_TIMEOUT_MS=100000
